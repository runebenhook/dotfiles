@import "~/.config/rofi/colors.rasi"

* {
    background-color: transparent;
    font: "Sans 11px";
}

window {
    width: 30%;
    padding: 12px;

    background-color: @background-main;

    border: 1px;
    border-color: @border-color;
    border-radius: 12px;
}

mainbox {
    spacing: 8px;

    children: [
        inputbar,
        listview
    ];
}

inputbar {
    padding: 7px 10px;
    spacing: 8px;

    background-color: @background-input;

    border-radius: 8px;

    children: [
        entry
    ];
}

entry {
    background-color: transparent;

    text-color: @foreground;

    placeholder: "Buscar aplicaciones...";
    placeholder-color: @foreground-alt;
}

listview {
    lines: 7;
    columns: 1;

    spacing: 2px;

    scrollbar: false;
    fixed-height: false;

    background-color: transparent;
}

element {
    padding: 5px 8px;
    spacing: 9px;

    background-color: transparent;

    border-radius: 7px;
}

element selected {
    background-color: @background-selected;
}

element-text {
    text-color: @foreground;
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
}
